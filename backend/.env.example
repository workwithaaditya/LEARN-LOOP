# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Configuration (Railway or local)
DATABASE_URL=postgresql://username:password@hostname:5432/learn-loop
# Alternative for Railway
POSTGRES_URL=postgresql://username:password@hostname:5432/learn-loop

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Session Secret
SESSION_SECRET=your_very_long_random_session_secret_here_change_this

# Frontend URL
FRONTEND_URL=http://localhost:5500

# WebRTC/Video Configuration
STUN_SERVER=stun:stun.l.google.com:19302
# Email Configuration (Gmail SMTP)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password-here

# Metered TURN Server API Key
METERED_API_KEY=af10e31f617aa49eb4024c3e52fcfae6eaa6